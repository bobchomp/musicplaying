<Window x:Class="MusicDisplay.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Display"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True"
        FontFamily="pack://application:,,,/Resources/Fonts/#Poppins"
        Icon="Assets/icon.ico">

    <StackPanel Margin="28">
        <TextBlock Text="Update available"
                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                   FontSize="18"
                   Margin="0,0,0,8" />
        <TextBlock x:Name="MessageText"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20" />

        <ProgressBar x:Name="DownloadProgressBar"
                     Height="6"
                     Minimum="0"
                     Maximum="100"
                     Visibility="Collapsed"
                     Margin="0,0,0,8" />
        <TextBlock x:Name="ProgressStatusText"
                   FontSize="11"
                   Opacity="0.6"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,0,0,16" />

        <Button x:Name="UpdateButton"
                Content="Update"
                Height="42"
                Style="{StaticResource AccentButtonStyle}"
                Click="UpdateButton_Click"
                Margin="0,0,0,10" />
        <Button x:Name="LaterButton"
                Content="Later"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="LaterButton_Click"
                IsCancel="True" />
    </StackPanel>
</Window>
