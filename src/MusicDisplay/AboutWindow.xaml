<Window x:Class="MusicDisplay.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Music Display"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="pack://application:,,,/Resources/Fonts/#Poppins"
        Icon="Assets/icon.ico">

    <StackPanel Margin="28">
        <TextBlock Text="Music Display"
                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                   FontSize="20"
                   Margin="0,0,0,4" />
        <TextBlock x:Name="VersionText"
                   FontSize="12"
                   Opacity="0.6"
                   Margin="0,0,0,16" />
        <TextBlock Text="Shows the album cover, title, and artist of whatever's playing, fullscreen on any monitor."
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20" />

        <TextBlock Text="THIRD-PARTY SOFTWARE" Style="{StaticResource SectionLabelStyle}" />
        <TextBlock FontSize="11"
                   Opacity="0.65"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"
                   Text="Poppins font (SIL Open Font License 1.1) and NAudio (MIT License) are bundled. The Network Feed option additionally uses the NDI Runtime, a separate free product from NDI/Vizrt under its own license — not bundled by this app; see the installer's Network Feed option or ndi.video." />

        <Button Content="View on GitHub"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="GitHubButton_Click"
                Margin="0,0,0,10" />
        <Button Content="Close"
                Height="42"
                Style="{StaticResource AccentButtonStyle}"
                Click="CloseButton_Click"
                IsCancel="True" />
    </StackPanel>
</Window>
