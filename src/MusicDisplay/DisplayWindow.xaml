<Window x:Class="MusicDisplay.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MusicDisplay"
        Title="Music Display"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Black">

    <Grid>
        <local:NowPlayingView x:Name="View" />
        <!-- Hidden, not Collapsed: it needs to stay part of layout at all times (Collapsed
             elements never get a real, laid-out window for WebView2 to attach to) so it's already
             fully initialized well before Show Music Video is ever clicked, rather than racing a
             layout pass that hasn't happened yet. Also deliberately not Opacity — WebView2 is a
             separately-composited native window (not a normal WPF visual), and controls like that
             are well known to ignore WPF's Opacity entirely, which just left it fully visible
             showing a plain white about:blank page after Stop. Hidden reserves the same layout
             space as Visible (unlike Collapsed) while actually hiding native window content
             (unlike Opacity). -->
        <local:MusicVideoPlayerView x:Name="MusicVideo" Visibility="Hidden" />
    </Grid>
</Window>
