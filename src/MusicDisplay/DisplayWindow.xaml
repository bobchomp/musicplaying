<Window x:Class="MusicDisplay.DisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MusicDisplay"
        Title="Music Display"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Black">

    <Grid>
        <local:NowPlayingView x:Name="View" />
        <!-- Opacity, not Visibility, controls whether this is shown — it needs to stay part of
             layout at all times (Collapsed elements never get a real, laid-out window for WebView2
             to attach to) so it's already fully initialized well before Show Music Video is ever
             clicked, rather than racing a layout pass that hasn't happened yet. -->
        <local:MusicVideoPlayerView x:Name="MusicVideo" Opacity="0" IsHitTestVisible="False" />
    </Grid>
</Window>
