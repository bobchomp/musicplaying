<UserControl x:Class="MusicDisplay.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DropShadowEffect x:Key="ArtShadow" Color="Black" BlurRadius="70" ShadowDepth="0" Opacity="0.6" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <SolidColorBrush x:Name="BackgroundBrush" Color="#0B0B0D" />
        </Grid.Background>

        <Viewbox Stretch="Uniform">
            <Grid x:Name="LayoutGrid" Width="1920" Height="1080">
                <StackPanel x:Name="ContentPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">

                    <Border x:Name="ArtBorder"
                            Width="560"
                            Height="560"
                            CornerRadius="18"
                            ClipToBounds="True"
                            Background="#22FFFFFF"
                            Effect="{StaticResource ArtShadow}"
                            HorizontalAlignment="Center">
                        <Image x:Name="AlbumArtImage" Stretch="UniformToFill" />
                    </Border>

                    <!-- Fixed-width clip so a long title scrolls in place on one line instead of
                         wrapping and pushing the artist text (and everything below it) further
                         down / off screen. TitleClip.Width is set per-layout in code-behind to
                         match the old MaxWidth/ContentPanel-width caps. A Canvas positions
                         TitleText via the Canvas.Left attached property (animated directly,
                         no RenderTransform) rather than a Border — Canvas.Left is an explicit
                         pixel offset with no alignment/arrange ambiguity for an oversized child. -->
                    <Canvas x:Name="TitleClip"
                            Height="100"
                            ClipToBounds="True"
                            Margin="0,52,0,10">
                        <TextBlock x:Name="TitleText"
                                   Canvas.Left="0"
                                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                                   FontSize="76"
                                   Foreground="White"
                                   TextWrapping="NoWrap" />
                    </Canvas>

                    <TextBlock x:Name="ArtistText"
                               FontFamily="pack://application:,,,/Resources/Fonts/#Poppins"
                               FontSize="38"
                               Foreground="#D9FFFFFF"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="1500" />
                </StackPanel>

                <StackPanel x:Name="IdlePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="IdleText"
                               Text="No music playing"
                               FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                               FontSize="56"
                               Foreground="#80FFFFFF"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="1500"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Only shown for the Centered layout while idle — Album left/right already have
                     their own always-on clock in the side panel next to the equalizer. Anchored
                     near the bottom of the screen rather than stacked under IdleText above. -->
                <StackPanel x:Name="IdleClockPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,100"
                            Visibility="Collapsed">
                    <TextBlock x:Name="IdleClockTimeText"
                               FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                               FontSize="56"
                               Foreground="#B3FFFFFF"
                               TextAlignment="Center"
                               Margin="0,0,0,8" />
                    <TextBlock x:Name="IdleClockDateText"
                               FontFamily="pack://application:,,,/Resources/Fonts/#Poppins"
                               FontSize="30"
                               Foreground="#80FFFFFF"
                               TextAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="SidePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <!-- Fixed to the same height as the album art (560) plus its bottom margin
                         (52) so the clock's time line lands exactly in line with the title line
                         below, however tall the equalizer happens to be, and even if it's
                         collapsed (nothing playing but the clock is still on). The equalizer
                         itself is bottom-aligned with a matching 52px bottom margin so its bars
                         end flush with the album art's bottom edge, not the bottom of this
                         whole spacer. -->
                    <Grid Height="612">
                        <!-- Synced lyrics for the Album left/right layouts: a 3-line ticker (just-sung
                             line on top, current line in the middle, next line on the bottom) filling
                             the space above the equalizer that's otherwise empty. Each slot is a
                             90px-tall Border (3 visible slots = 270px), leaving a deliberate 30px of
                             slack below the visible window before the 300px clip boundary — the
                             equalizer itself starts exactly at 300 (this Grid's 612px height minus its
                             260px height and 52px bottom margin), so this buffer keeps the bottom line
                             from ever sitting flush against that edge. Each TextBlock sits in a Viewbox
                             (Stretch="Uniform", StretchDirection="DownOnly") instead of using
                             TextTrimming — a too-long line shrinks in place to fit on one line rather
                             than getting cut off with an ellipsis; short lines are unaffected, since
                             DownOnly never scales up past the TextBlock's own FontSize. The TextBlock
                             has no explicit Width so the Viewbox sees its real, untrimmed size to scale
                             against — a fixed Width would always measure as "exactly fits" regardless
                             of the actual text length, defeating the shrink entirely. Five slots (not
                             three) are kept so the outer two can hold the lines just outside the
                             visible window, clipped out of view — advancing a line slides the whole
                             stack up by one slot, revealing the fifth slot's line at the bottom instead
                             of popping straight to new text, then the window is silently re-centered
                             afterwards. Centered layout has no side space for this and keeps the
                             single-line CurrentLyricText at the bottom of the screen instead. -->
                        <Grid x:Name="EdgeLyricsPanel"
                              Height="300"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Center"
                              ClipToBounds="True"
                              Visibility="Collapsed">
                            <!-- A Canvas with each row's Canvas.Top set explicitly, not a StackPanel —
                                 this content is intentionally taller (450px) than the clip window
                                 above (300px), and a StackPanel's own arranged position when its
                                 content can't be compressed to fit isn't something to rely on being
                                 top-anchored; a Canvas has no such ambiguity, since every child's
                                 position is a plain fixed offset from the Canvas's own origin
                                 regardless of how much it overflows. Same reasoning already applied
                                 to TitleClip/TitleText above for the same kind of oversized-child
                                 clipping. VerticalAlignment="Top" here removes the same ambiguity for
                                 the Canvas's own placement within this Grid. -->
                            <Canvas x:Name="EdgeLyricsStack" Width="690" Height="450" VerticalAlignment="Top">
                                <Canvas.RenderTransform>
                                    <TranslateTransform x:Name="EdgeLyricsTransform" Y="-90" />
                                </Canvas.RenderTransform>

                                <Border Canvas.Top="0" Width="690" Height="90">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                        <TextBlock x:Name="EdgeLyricSlot0"
                                                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins"
                                                   FontSize="26"
                                                   Foreground="#80FFFFFF"
                                                   TextAlignment="Center"
                                                   TextWrapping="NoWrap" />
                                    </Viewbox>
                                </Border>
                                <Border Canvas.Top="90" Width="690" Height="90">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                        <TextBlock x:Name="EdgeLyricSlot1"
                                                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins"
                                                   FontSize="26"
                                                   Foreground="#80FFFFFF"
                                                   TextAlignment="Center"
                                                   TextWrapping="NoWrap" />
                                    </Viewbox>
                                </Border>
                                <Border Canvas.Top="180" Width="690" Height="90">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                        <TextBlock x:Name="EdgeLyricSlot2"
                                                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                                                   FontSize="38"
                                                   Foreground="White"
                                                   TextAlignment="Center"
                                                   TextWrapping="NoWrap" />
                                    </Viewbox>
                                </Border>
                                <Border Canvas.Top="270" Width="690" Height="90">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                        <TextBlock x:Name="EdgeLyricSlot3"
                                                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins"
                                                   FontSize="26"
                                                   Foreground="#80FFFFFF"
                                                   TextAlignment="Center"
                                                   TextWrapping="NoWrap" />
                                    </Viewbox>
                                </Border>
                                <Border Canvas.Top="360" Width="690" Height="90">
                                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                        <TextBlock x:Name="EdgeLyricSlot4"
                                                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins"
                                                   FontSize="26"
                                                   Foreground="#80FFFFFF"
                                                   TextAlignment="Center"
                                                   TextWrapping="NoWrap" />
                                    </Viewbox>
                                </Border>
                            </Canvas>
                        </Grid>

                        <StackPanel x:Name="EqualizerPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Height="260"
                                    Margin="0,0,0,52"
                                    Visibility="Collapsed">
                            <StackPanel.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="34" />
                                    <Setter Property="Height" Value="260" />
                                    <Setter Property="Margin" Value="14,0" />
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="Background" Value="#4DFFFFFF" />
                                    <Setter Property="VerticalAlignment" Value="Bottom" />
                                    <Setter Property="RenderTransformOrigin" Value="0.5,1" />
                                </Style>
                            </StackPanel.Resources>
                            <!-- Bars are a fixed height and animate a per-instance ScaleTransform
                                 (render-thread, bottom-anchored) instead of the Height property,
                                 so the animation doesn't force a UI-thread layout pass every
                                 frame. -->
                            <Border x:Name="EqBar1">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.35" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="EqBar2">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.65" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="EqBar3">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.88" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="EqBar4">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.5" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="EqBar5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.77" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="EqBar6">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.42" />
                                </Border.RenderTransform>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="ClockPanel"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <!-- Same font/size as TitleText/ArtistText, and the same 10px gap
                             between them, so the two lines match exactly. -->
                        <TextBlock x:Name="ClockTimeText"
                                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                                   FontSize="76"
                                   Foreground="White"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="1500"
                                   Margin="0,0,0,10" />
                        <TextBlock x:Name="ClockDateText"
                                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins"
                                   FontSize="38"
                                   Foreground="#D9FFFFFF"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="1500" />
                    </StackPanel>
                </StackPanel>

                <!-- Synced lyrics: one line at a time, same position in every layout since it
                     spans the full canvas width independent of where the art/side panel sit. -->
                <TextBlock x:Name="CurrentLyricText"
                           FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                           FontSize="48"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="1700"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,60"
                           Visibility="Collapsed" />
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
