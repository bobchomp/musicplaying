<UserControl x:Class="MusicDisplay.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DropShadowEffect x:Key="ArtShadow" Color="Black" BlurRadius="70" ShadowDepth="0" Opacity="0.6" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <SolidColorBrush x:Name="BackgroundBrush" Color="#0B0B0D" />
        </Grid.Background>

        <Viewbox Stretch="Uniform">
            <Grid Width="1920" Height="1080">
                <StackPanel x:Name="ContentPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">

                    <Border x:Name="ArtBorder"
                            Width="560"
                            Height="560"
                            CornerRadius="18"
                            ClipToBounds="True"
                            Background="#22FFFFFF"
                            Effect="{StaticResource ArtShadow}"
                            HorizontalAlignment="Center">
                        <Image x:Name="AlbumArtImage" Stretch="UniformToFill" />
                    </Border>

                    <TextBlock x:Name="TitleText"
                               FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                               FontSize="76"
                               Foreground="White"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="1500"
                               Margin="0,52,0,10" />

                    <TextBlock x:Name="ArtistText"
                               FontFamily="pack://application:,,,/Resources/Fonts/#Poppins"
                               FontSize="38"
                               Foreground="#D9FFFFFF"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="1500" />
                </StackPanel>

                <StackPanel x:Name="EqualizerPanel"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Height="260"
                            Visibility="Collapsed">
                    <StackPanel.Resources>
                        <Style TargetType="Border">
                            <Setter Property="Width" Value="34" />
                            <Setter Property="Margin" Value="14,0" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Background" Value="#4DFFFFFF" />
                            <Setter Property="VerticalAlignment" Value="Bottom" />
                        </Style>
                    </StackPanel.Resources>
                    <Border x:Name="EqBar1" Height="90" />
                    <Border x:Name="EqBar2" Height="170" />
                    <Border x:Name="EqBar3" Height="230" />
                    <Border x:Name="EqBar4" Height="130" />
                    <Border x:Name="EqBar5" Height="200" />
                    <Border x:Name="EqBar6" Height="110" />
                </StackPanel>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
