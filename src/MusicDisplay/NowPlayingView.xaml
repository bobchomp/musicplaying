<UserControl x:Class="MusicDisplay.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DropShadowEffect x:Key="ArtShadow" Color="Black" BlurRadius="70" ShadowDepth="0" Opacity="0.6" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <SolidColorBrush x:Name="BackgroundBrush" Color="#0B0B0D" />
        </Grid.Background>

        <Viewbox Stretch="Uniform">
            <Grid x:Name="LayoutGrid" Width="1920" Height="1080">
                <StackPanel x:Name="ContentPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">

                    <Border x:Name="ArtBorder"
                            Width="560"
                            Height="560"
                            CornerRadius="18"
                            ClipToBounds="True"
                            Background="#22FFFFFF"
                            Effect="{StaticResource ArtShadow}"
                            HorizontalAlignment="Center">
                        <Image x:Name="AlbumArtImage" Stretch="UniformToFill" />
                    </Border>

                    <TextBlock x:Name="TitleText"
                               FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                               FontSize="76"
                               Foreground="White"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="1500"
                               Margin="0,52,0,10" />

                    <TextBlock x:Name="ArtistText"
                               FontFamily="pack://application:,,,/Resources/Fonts/#Poppins"
                               FontSize="38"
                               Foreground="#D9FFFFFF"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="1500" />
                </StackPanel>

                <TextBlock x:Name="IdleText"
                           Text="No music playing"
                           FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                           FontSize="56"
                           Foreground="#80FFFFFF"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="1500"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />

                <StackPanel x:Name="SidePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <StackPanel x:Name="EqualizerPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Height="260"
                                Visibility="Collapsed">
                        <StackPanel.Resources>
                            <Style TargetType="Border">
                                <Setter Property="Width" Value="34" />
                                <Setter Property="Height" Value="260" />
                                <Setter Property="Margin" Value="14,0" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Background" Value="#4DFFFFFF" />
                                <Setter Property="VerticalAlignment" Value="Bottom" />
                                <Setter Property="RenderTransformOrigin" Value="0.5,1" />
                            </Style>
                        </StackPanel.Resources>
                        <!-- Bars are a fixed height and animate a per-instance ScaleTransform
                             (render-thread, bottom-anchored) instead of the Height property, so
                             the animation doesn't force a UI-thread layout pass every frame. -->
                        <Border x:Name="EqBar1">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="0.35" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="EqBar2">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="0.65" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="EqBar3">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="0.88" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="EqBar4">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="0.5" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="EqBar5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="0.77" />
                            </Border.RenderTransform>
                        </Border>
                        <Border x:Name="EqBar6">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleY="0.42" />
                            </Border.RenderTransform>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ClockPanel"
                                HorizontalAlignment="Center"
                                Margin="0,40,0,0"
                                Visibility="Collapsed">
                        <TextBlock x:Name="ClockTimeText"
                                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                                   FontSize="56"
                                   Foreground="White"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="600" />
                        <TextBlock x:Name="ClockDateText"
                                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins"
                                   FontSize="26"
                                   Foreground="#BFFFFFFF"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="600"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
