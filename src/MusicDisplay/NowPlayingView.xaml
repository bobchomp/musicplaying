<UserControl x:Class="MusicDisplay.NowPlayingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <DropShadowEffect x:Key="ArtShadow" Color="Black" BlurRadius="70" ShadowDepth="0" Opacity="0.6" />
    </UserControl.Resources>

    <Grid x:Name="RootGrid">
        <Grid.Background>
            <SolidColorBrush x:Name="BackgroundBrush" Color="#0B0B0D" />
        </Grid.Background>

        <Viewbox Stretch="Uniform">
            <Grid x:Name="LayoutGrid" Width="1920" Height="1080">
                <StackPanel x:Name="ContentPanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">

                    <Border x:Name="ArtBorder"
                            Width="560"
                            Height="560"
                            CornerRadius="18"
                            ClipToBounds="True"
                            Background="#22FFFFFF"
                            Effect="{StaticResource ArtShadow}"
                            HorizontalAlignment="Center">
                        <Image x:Name="AlbumArtImage" Stretch="UniformToFill" />
                    </Border>

                    <!-- Fixed-width clip so a long title scrolls in place on one line instead of
                         wrapping and pushing the artist text (and everything below it) further
                         down / off screen. TitleClip.Width is set per-layout in code-behind to
                         match the old MaxWidth/ContentPanel-width caps. -->
                    <Border x:Name="TitleClip"
                            ClipToBounds="True"
                            Margin="0,52,0,10">
                        <TextBlock x:Name="TitleText"
                                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                                   FontSize="76"
                                   Foreground="White"
                                   TextAlignment="Center"
                                   TextWrapping="NoWrap">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="TitleScrollTransform" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>

                    <TextBlock x:Name="ArtistText"
                               FontFamily="pack://application:,,,/Resources/Fonts/#Poppins"
                               FontSize="38"
                               Foreground="#D9FFFFFF"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="1500" />
                </StackPanel>

                <StackPanel x:Name="IdlePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <TextBlock x:Name="IdleText"
                               Text="No music playing"
                               FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                               FontSize="56"
                               Foreground="#80FFFFFF"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="1500"
                               HorizontalAlignment="Center" />

                    <!-- Only shown for the Centered layout while idle — Album left/right already
                         have their own always-on clock in the side panel next to the equalizer. -->
                    <StackPanel x:Name="IdleClockPanel"
                                HorizontalAlignment="Center"
                                Margin="0,36,0,0"
                                Visibility="Collapsed">
                        <TextBlock x:Name="IdleClockTimeText"
                                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                                   FontSize="56"
                                   Foreground="#B3FFFFFF"
                                   TextAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="IdleClockDateText"
                                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins"
                                   FontSize="30"
                                   Foreground="#80FFFFFF"
                                   TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="SidePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                    <!-- Fixed to the same height as the album art (560) plus its bottom margin
                         (52) so the clock's time line lands exactly in line with the title line
                         below, however tall the equalizer happens to be, and even if it's
                         collapsed (nothing playing but the clock is still on). The equalizer
                         itself is bottom-aligned with a matching 52px bottom margin so its bars
                         end flush with the album art's bottom edge, not the bottom of this
                         whole spacer. -->
                    <Grid Height="612">
                        <StackPanel x:Name="EqualizerPanel"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Bottom"
                                    Height="260"
                                    Margin="0,0,0,52"
                                    Visibility="Collapsed">
                            <StackPanel.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="Width" Value="34" />
                                    <Setter Property="Height" Value="260" />
                                    <Setter Property="Margin" Value="14,0" />
                                    <Setter Property="CornerRadius" Value="8" />
                                    <Setter Property="Background" Value="#4DFFFFFF" />
                                    <Setter Property="VerticalAlignment" Value="Bottom" />
                                    <Setter Property="RenderTransformOrigin" Value="0.5,1" />
                                </Style>
                            </StackPanel.Resources>
                            <!-- Bars are a fixed height and animate a per-instance ScaleTransform
                                 (render-thread, bottom-anchored) instead of the Height property,
                                 so the animation doesn't force a UI-thread layout pass every
                                 frame. -->
                            <Border x:Name="EqBar1">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.35" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="EqBar2">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.65" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="EqBar3">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.88" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="EqBar4">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.5" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="EqBar5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.77" />
                                </Border.RenderTransform>
                            </Border>
                            <Border x:Name="EqBar6">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleY="0.42" />
                                </Border.RenderTransform>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="ClockPanel"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                        <!-- Same font/size as TitleText/ArtistText, and the same 10px gap
                             between them, so the two lines match exactly. -->
                        <TextBlock x:Name="ClockTimeText"
                                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins SemiBold"
                                   FontSize="76"
                                   Foreground="White"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="1500"
                                   Margin="0,0,0,10" />
                        <TextBlock x:Name="ClockDateText"
                                   FontFamily="pack://application:,,,/Resources/Fonts/#Poppins"
                                   FontSize="38"
                                   Foreground="#D9FFFFFF"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="1500" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
